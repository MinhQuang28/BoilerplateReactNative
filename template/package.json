{
  "name": "helloworld",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "postinstall": "node ./scripts/setup.js",
    "start": "node scripts/start.js env/dev.json",
    "splash": "node ./scripts/splash.js assets/splash/splash.png FFFFFF 150 main BootSplash",
    "type:check": "yarn tsc --noEmit --skipLibCheck",
    "ios:notification:dev": "node ./scripts/ios.js push-notification env/dev.json ",
    "android:report": "node scripts/android.js report",
    "android:hash": "node scripts/android.js hash",
    "android:gen-key": "node scripts/android.js keystore",
    "ios:dev": "node scripts/ios.js run env/dev.json",
    "android:dev": "node scripts/android.js run env/dev.json Debug",
    "android:release": "node scripts/android.js run env/dev.json Release",
    "lint": "eslint index.ts ./declare/**/*.ts ./scripts/**/*.js  ./src/**/*.{ts,tsx}"
  },
  "dependencies": {
    "@gorhom/portal": "^1.0.14",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/native-stack": "^7.3.27",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.3.0",
    "axios": "^1.12.2",
    "expo": "~54.0.12",
    "expo-dev-client": "~6.0.13",
    "expo-font": "~14.0.8",
    "expo-image": "~3.0.9",
    "expo-status-bar": "~3.0.8",
    "i18next": "^25.5.3",
    "immer": "^10.1.3",
    "intl-pluralrules": "^2.0.1",
    "moment": "^2.30.1",
    "react": "19.1.0",
    "react-fast-compare": "^3.2.2",
    "react-freeze": "^1.0.4",
    "react-hook-form": "^7.64.0",
    "react-i18next": "^16.0.0",
    "react-native": "0.81.4",
    "react-native-bootsplash": "^6.3.10",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-keys": "0.7.13",
    "react-native-mmkv": "^3.3.3",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-unistyles": "2.43.0",
    "react-native-worklets": "^0.6.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@eslint/compat": "^1.4.0",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.7.0",
    "@react-native/eslint-config": "0.81.4",
    "@react-native/metro-config": "0.81.4",
    "@react-native/typescript-config": "0.81.4",
    "@types/jest": "^29.5.11",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^8.46.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^8.19.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "jest": "^29.6.3",
    "lefthook": "^1.13.6",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "typescript": "~5.5.0"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@gorhom/portal",
          "intl-pluralrules",
          "moment",
          "react-fast-compare",
          "immer"
        ]
      }
    }
  }
}
